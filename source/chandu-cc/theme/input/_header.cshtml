</section>



  <script>

        // HERO ANIMATION
     const titleText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(jsTitle));
@* 
   // console.log("------------------");
    // console.log(titleText); // ["Chandra Kanth","Full Stack Engineer"] *@

    const titleEl = document.getElementById("hero-title");

     titleText.forEach(line => {
        const div = document.createElement("div"); // new line
        div.className = "block"; // ensures it's a new line
        line.split(" ").forEach(word => {
            const span = document.createElement("span");
            span.innerHTML = word + "&nbsp;";
            
            span.className = "inline-block opacity-0 translate-y-4 align-baseline leading-normal";


            div.appendChild(span);
        });
        titleEl.appendChild(div);
    });

    gsap.to("#hero-title span", 
    { opacity:1, y:0, stagger:0.1, duration:0.6, ease:"power3.out" });

    gsap.to("#hero-sub", 
    { opacity:1, y:0, delay:1, duration:0.8, ease:"power2.out" });

    gsap.to("#hero-buttons", 
    { opacity:1, y:0, delay:1.4, duration:0.7, ease:"back.out(1.7)" });


    // FADE-IN SCROLL ANIMATION ONLY FOR DESKTOP
    if (window.innerWidth >= 768) { // desktop
      gsap.utils.toArray(".fade-section").forEach(section => {
        gsap.from(section, {
          scrollTrigger: {
            trigger: section,
            start: "top 85%",
          },
          opacity: 0,
          y: 50,
          duration: 1,
          ease: "power2.out"
        });
      });
    }

  </script>


