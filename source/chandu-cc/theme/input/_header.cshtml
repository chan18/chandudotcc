        {
            <p class="z-50 mt-4  bg-gradient-to-bl from-pink-500 via-gray-700 to-slate-800 bg-clip-text text-transparent
         dark:bg-gradient-to-bl dark:from-pink-400 dark:via-neutral-200 dark:to-slate-400"> 
                Published on @Document.GetDateTime(WebKeys.Published).ToLongDateString() 
                </p>

            <div class="mt-2">
                @if (Document.ContainsKey("Tags"))
                {
                    <div class="mt-3 space-x-2">
                        @foreach (IDocument tag in Document
                                                    .GetList<string>("Tags")
                                                    .Select(x => Outputs["tags.html"].First()
                                                    .GetChildren()
                                                    .FirstOrDefault(y => y.GetTitle()
                                                    .Equals(x, StringComparison.OrdinalIgnoreCase)))
                                                    .Where(x => x != null))
                        {


                        <a href="@Context.GetLink(tag)" 
                        class="m-2 inline-block px-3 py-1 text-sm font-semibold rounded-full
       border border-gray-300 bg-white cursor-pointer
       transition duration-300 ease-out transform
       hover:scale-105 hover:shadow-lg hover:shadow-pink-500/30
       dark:border-gray-600 dark:bg-gray-900 dark:hover:bg-gray-800
       dark:hover:shadow-pink-400/20
       bg-gradient-to-bl from-pink-500 via-gray-700 to-slate-800 
       bg-clip-text text-transparent
       dark:bg-gradient-to-bl dark:from-pink-400 dark:via-neutral-200 dark:to-slate-400
       hover:bg-gradient-to-r hover:from-pink-500 hover:to-purple-600 hover:text-white hover:bg-clip-border
       dark:hover:bg-gradient-to-r dark:hover:from-pink-600 dark:hover:to-purple-800 dark:hover:text-neutral-100"
>
